          <mxGeometry x="1572" y="478" width="58" height="26" as="geometry" />
        </mxCell>

        <!-- 片外 -->
        <mxCell id="HW_ext_title" value="片外器件 (PCB 上的)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1" vertex="1" parent="1">
          <mxGeometry x="1380" y="515" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="HW_e1" value="DDR 颗粒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0ff;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1380" y="540" width="80" height="26" as="geometry" />
        </mxCell>
        <mxCell id="HW_e2" value="eMMC/SD 卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0ff;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1468" y="540" width="80" height="26" as="geometry" />
        </mxCell>
        <mxCell id="HW_e3" value="PMIC 电源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0ff;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1556" y="540" width="74" height="26" as="geometry" />
        </mxCell>
        <mxCell id="HW_e4" value="PHY + RJ45" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0ff;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1380" y="572" width="80" height="26" as="geometry" />
        </mxCell>
        <mxCell id="HW_e5" value="Flash/NAND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0ff;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1468" y="572" width="80" height="26" as="geometry" />
        </mxCell>
        <mxCell id="HW_e6" value="晶振/复位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0ff;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1556" y="572" width="74" height="26" as="geometry" />
        </mxCell>

        <!-- 架构说明框 -->
        <mxCell id="HW_why" value="为什么需要这个架构？&#xa;━━━━━━━━━━━━━━━━━&#xa;• SoC ≠ CPU：一颗封装内集成 CPU核+GPU+VPU+DDRC+总线桥+外设控制器&#xa;• 必须有 总线分层(AXI高速/AHB中速/APB低速) 与 地址映射，CPU 才能访问到每个 IP&#xa;• 没有 GIC，外设无法把中断送到 CPU；没有 SCP，大小核频率/电源无法协调&#xa;• 启动链(ROM→SPL→U-Boot→Kernel) 正是逐级唤醒这套架构的过程" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#fffbe6;strokeColor=#d6b656;rounded=1" vertex="1" parent="1">
          <mxGeometry x="1380" y="610" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- ============ 底部：三大关系总结 ============ -->
        <mxCell id="REL_title" value="三个核心问题 —— 关系速查" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1" vertex="1" parent="1">
          <mxGeometry x="180" y="810" width="1450" height="30" as="geometry" />
        </mxCell>

        <mxCell id="REL1" value="Q1: SoC 如何启动？&#xa;━━━━━━━━━━━&#xa;分层接力赛，每一棒把下一棒代码加载并跳转：&#xa;上电 → ROM Boot → SPL(初始化DRAM) → U-Boot → Linux Kernel → rootfs/init&#xa;关键：DRAM 初始化前只能在 SRAM 跑(故有 SPL) ；每棒跑在不同物理内存上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="200" y="850" width="450" height="130" as="geometry" />
        </mxCell>

        <mxCell id="REL2" value="Q2: 架构 &amp; 与 Linux 关系？&#xa;━━━━━━━━━━━&#xa;架构 = SoC 硬件互联(总线/IP/地址映射) + 启动分层链路&#xa;Linux 只跑在最后两棒(Kernel+rootfs)，依赖前面留下的遗产：&#xa;  • DTB 设备树：U-Boot 传给内核，内核据此知道板子有什么外设&#xa;  • bootargs：console= root= mem= 等启动参数&#xa;  • 镜像格式/加载地址/握手约定&#xa;本质：前面几棒把内核+硬件描述一起送到正确地址，Linux 才能跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="675" y="850" width="450" height="130" as="geometry" />
        </mxCell>

        <mxCell id="REL3" value="Q3: 和大小核什么关系？&#xa;━━━━━━━━━━━&#xa;big.LITTLE 异构多核(A76大+A55小等)：&#xa;  • 启动时：BootROM 只让主核跑，其余核 WFE 等待；U-Boot 写入口+SEV 唤醒&#xa;  • 运行时：Linux CPUFreq+EAS 调度，按负载放大核(性能)/小核(省电)&#xa;  • 协同：经 SCP/PSCI 接口下发频率与电源状态&#xa;结论：大小核既属硬件架构，又需 U-Boot唤醒+Linux调度+SCP协同 三段配合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1150" y="850" width="450" height="130" as="geometry" />
        </mxCell>

        <!-- DTB 桥接示意 (跨阶段连接) -->
        <mxCell id="dtb_bridge" value="DTB 设备树 —— 软硬件之间的桥&#xa;(U-Boot 传递 → 内核解析 → 驱动匹配)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1" vertex="1" parent="1">
          <mxGeometry x="180" y="790" width="1140" height="0" as="geometry" />
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend_title" value="图例" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1360" y="1000" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="启动阶段 (时间轴)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1360" y="1025" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="SoC 内部 IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1455" y="1025" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="片外器件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0ff;strokeColor=#6c8ebf;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1550" y="1025" width="80" height="24" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
